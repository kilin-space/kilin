{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".source/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:e2e": {
      "dependsOn": ["build", "test"],
      "cache": false
    },
    "pack:check": {
      "dependsOn": ["build", "test:e2e"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
